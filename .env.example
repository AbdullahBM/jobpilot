# JobPilot sends email through your LOGGED-IN Gmail web tab by default — no SMTP needed.
# These are OPTIONAL: only set them if you prefer classic SMTP sending instead.
# Get a Gmail App Password at https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=

# Optional: override the Chrome DevTools endpoint (default http://127.0.0.1:9222)
# CDP_ENDPOINT=http://127.0.0.1:9222

# Optional: dashboard/onboarding port (default 7788)
# JOB_AGENT_PORT=7788
